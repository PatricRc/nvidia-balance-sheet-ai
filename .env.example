# Placeholder names only. Copy to .env locally (gitignored) or set in
# Fabric / Azure Key Vault. Never commit real values.

# Required by SEC fair-access: declare who you are on every request.
# Format tip: "Name email@domain" — see https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="Your Name your@email"

# Claude Messages API — real value comes from Azure Key Vault at runtime.
# Do NOT put a live key here, in notebooks checked into git, DAX, Power BI, or HTML.
ANTHROPIC_API_KEY=from-azure-key-vault

# Microsoft Fabric targets (fill once the workspace / lakehouse exist)
FABRIC_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
FABRIC_LAKEHOUSE_ID=00000000-0000-0000-0000-000000000000
FABRIC_WORKSPACE_NAME=NVIDIA-BalanceSheet-Dev
FABRIC_LAKEHOUSE_NAME=NVIDIALakehouse

# Optional: Azure Key Vault that holds ANTHROPIC_API_KEY
AZURE_KEY_VAULT_NAME=your-key-vault-name
AZURE_KEY_VAULT_SECRET_NAME=anthropic-api-key
