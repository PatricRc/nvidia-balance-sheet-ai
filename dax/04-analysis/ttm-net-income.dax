// TTM Net Income
// Table: _Measures
// Display folder: Category\04 Analysis\TTM;Pages\00 Cover;Pages\05 Financial Statements
// Format: #,##0
// Hidden: false
// Trailing four standalone fiscal quarters of Net Income ending at the latest period in context ([Net Income Standalone Quarter], so Q4 = FY − Q1 − Q2 − Q3). BLANK unless all four quarters exist. If the current period is the annual 10-K (FY or duration > 300 days), this equals [Net Income].

TTM Net Income =
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
VAR _fp =
    CALCULATE(
        MAX('Income Statement'[fiscal_period]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
VAR _days =
    CALCULATE(
        MAX('Income Statement'[duration_days]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
VAR _annual = _fp = "FY" || _days > 300
VAR _q_ends =
    TOPN(
        4,
        CALCULATETABLE(
            VALUES('Date'[date]),
            REMOVEFILTERS('Date'),
            'Date'[is_fiscal_quarter_end] = TRUE(),
            'Date'[date] <= _end
        ),
        'Date'[date], DESC
    )
VAR _quarters =
    ADDCOLUMNS(
        _q_ends,
        "@v",
            VAR _d = 'Date'[date]
            RETURN CALCULATE([Net Income Standalone Quarter], REMOVEFILTERS('Date'), 'Date'[date] = _d)
    )
VAR _n = COUNTROWS(FILTER(_quarters, NOT ISBLANK([@v])))
RETURN
IF(
    ISBLANK(_end),
    BLANK(),
    IF(_annual, [Net Income], IF(_n = 4, SUMX(_quarters, [@v])))
)
