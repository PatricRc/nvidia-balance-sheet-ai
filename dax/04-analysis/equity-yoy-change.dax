// Equity YoY Change
// Table: _Measures
// Display folder: Category\04 Analysis\Growth;Pages\01 Financial Position
// Format: #,##0
// Hidden: false
// Equity minus the same NVIDIA fiscal quarter in the prior fiscal year (Date[fiscal_year]/[fiscal_quarter] quarter-end). Not SAMEPERIODLASTYEAR. BLANK when the current or prior value is missing.

Equity YoY Change =
VAR _end =
    CALCULATE(
        MAX('Balance Sheet'[period_end]),
        'Balance Sheet'[is_latest_filing] = TRUE()
    )
VAR _curr = [Total Equity]
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _prior_end =
    CALCULATE(
        MAX('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _fy - 1,
        'Date'[fiscal_quarter] = _fq,
        'Date'[is_fiscal_quarter_end] = TRUE()
    )
VAR _prior =
    CALCULATE(
        [Total Equity],
        REMOVEFILTERS('Date'),
        'Date'[date] = _prior_end
    )
RETURN
IF(ISBLANK(_curr) || ISBLANK(_prior), BLANK(), _curr - _prior)
