// Average Receivables
// Table: _Measures
// Display folder: Category\03 Ratios\Helpers
// Format: #,##0
// Hidden: false
// Average of ending and prior-period-end (prior FY end at year grain, prior fiscal quarter end at quarter grain) Accounts Receivable. Falls back to ending AR if the prior period is missing.

Average Receivables =
VAR _end =
    CALCULATE(
        MAX('Balance Sheet'[period_end]),
        'Balance Sheet'[is_latest_filing] = TRUE()
    )
VAR _curr = [Accounts Receivable]
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _annual =
    DATEDIFF(MIN('Date'[date]), MAX('Date'[date]), DAY) > 120
VAR _prior_fy = IF(_annual || _fq = 1, _fy - 1, _fy)
VAR _prior_fq = IF(_annual || _fq = 1, 4, _fq - 1)
VAR _prior_end =
    CALCULATE(
        MAX('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _prior_fy,
        'Date'[fiscal_quarter] = _prior_fq,
        'Date'[is_fiscal_quarter_end] = TRUE()
    )
VAR _prior =
    CALCULATE(
        [Accounts Receivable],
        REMOVEFILTERS('Date'),
        'Date'[date] = _prior_end
    )
RETURN
IF(ISBLANK(_prior), _curr, DIVIDE(_curr + _prior, 2))
