// Quick Ratio
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.00
// Hidden: false
// (Cash + Marketable Securities + Accounts Receivable) / Current Liabilities. Follows [Marketable Securities]. BLANK when that measure is BLANK so a missing securities tag is never treated as 0.

Quick Ratio =
VAR _ms = [Marketable Securities]
RETURN
IF(
    ISBLANK(_ms),
    BLANK(),
    DIVIDE([Cash] + _ms + [Accounts Receivable], [Current Liabilities])
)
