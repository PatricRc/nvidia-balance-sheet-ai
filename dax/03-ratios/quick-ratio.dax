// Quick Ratio
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.00
// Hidden: false
// (Cash + Marketable Securities + Accounts Receivable) / Current Liabilities. BLANK when Marketable Securities is not tagged (FY2026 onward) — treating it as 0 would understate NVIDIA's liquidity by tens of billions.

Quick Ratio =
VAR _ms = [Marketable Securities]
RETURN
IF(
    ISBLANK(_ms),
    BLANK(),
    DIVIDE([Cash] + _ms + [Accounts Receivable], [Current Liabilities])
)
