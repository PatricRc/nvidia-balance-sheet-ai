// Net Margin %
// Table: _Measures
// Display folder: Category\03 Ratios\Profitability;Pages\04 Notes & Evidence;Pages\05 Financial Statements
// Format: 0.0%
// Hidden: false
// Net Income / Revenue for the latest period in context. Same definition as 01-base [Net Income Margin %].

Net Margin % =
DIVIDE([Net Income], [Revenue])
