// Revenue YoY %
// Table: _Measures
// Display folder: 01-base
// Format: 0.0%
// Hidden: false
// Revenue versus the same NVIDIA fiscal quarter in the prior fiscal year (matched on Date[fiscal_year]/[fiscal_quarter] quarter-end), not SAMEPERIODLASTYEAR.

Revenue YoY % =
VAR _curr = [Revenue]
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _prior_end =
    CALCULATE(
        MAX('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _fy - 1,
        'Date'[fiscal_quarter] = _fq,
        'Date'[is_fiscal_quarter_end] = TRUE()
    )
VAR _prior =
    CALCULATE(
        [Revenue],
        REMOVEFILTERS('Date'),
        'Date'[date] = _prior_end
    )
RETURN
DIVIDE(_curr - _prior, _prior)
