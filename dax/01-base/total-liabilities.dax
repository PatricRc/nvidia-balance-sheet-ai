// Total Liabilities
// Table: _Measures
// Display folder: Category\01 Base\Balance Sheet;Pages\01 Financial Position;Pages\04 Notes & Evidence;Pages\05 Financial Statements
// Format: #,##0
// Hidden: false
// Point-in-time us-gaap Liabilities; latest period_end; is_latest_filing only.

Total Liabilities =
VAR _end =
    CALCULATE(
        MAX('Balance Sheet'[period_end]),
        'Balance Sheet'[is_latest_filing] = TRUE()
    )
RETURN
CALCULATE(
    SUM('Balance Sheet'[value_usd]),
    'Balance Sheet'[concept] = "Liabilities",
    'Balance Sheet'[is_latest_filing] = TRUE(),
    'Balance Sheet'[period_end] = _end
)
