// Revenue
// Table: _Measures
// Display folder: Category\01 Base\Income Statement;Pages\00 Cover;Pages\05 Financial Statements
// Format: #,##0
// Hidden: false
// Duration revenue for the single latest period_end in context (is_latest_filing). Prefers RevenueFromContractWithCustomerExcludingAssessedTax when present, else Revenues. Not a sum of quarters. On a 10-Q this is the standalone fiscal quarter (gold prefers the 3-month row over YTD); on the FY 10-K it is the annual total.

Revenue =
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
VAR _contract =
    CALCULATE(
        SUM('Income Statement'[value_usd]),
        'Income Statement'[concept] = "RevenueFromContractWithCustomerExcludingAssessedTax",
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
VAR _legacy =
    CALCULATE(
        SUM('Income Statement'[value_usd]),
        'Income Statement'[concept] = "Revenues",
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
RETURN
COALESCE(_contract, _legacy)
