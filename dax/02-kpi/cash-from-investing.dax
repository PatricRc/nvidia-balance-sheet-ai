// Cash from Investing
// Table: Balance Sheet
// Display folder: 02-kpi
// Format: #,##0
// Hidden: false
// Duration NetCashProvidedByUsedInInvestingActivities at the latest period_end (is_latest_filing). 10-Q may be YTD.

Cash from Investing =
VAR _end =
    CALCULATE(
        MAX('Cash Flow'[period_end]),
        'Cash Flow'[is_latest_filing] = TRUE()
    )
RETURN
CALCULATE(
    SUM('Cash Flow'[value_usd]),
    'Cash Flow'[concept] = "NetCashProvidedByUsedInInvestingActivities",
    'Cash Flow'[is_latest_filing] = TRUE(),
    'Cash Flow'[period_end] = _end
)
