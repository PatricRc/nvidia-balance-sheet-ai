// Operating Lease Liabilities
// Table: _Measures
// Display folder: Category\02 KPI\Balance Sheet;Pages\03 Debt & Net Cash
// Format: #,##0
// Hidden: false
// OperatingLeaseLiabilityCurrent + OperatingLeaseLiabilityNoncurrent at the latest period_end (is_latest_filing). Shown separately from debt; never netted into Net Cash.

Operating Lease Liabilities =
VAR _end =
    CALCULATE(
        MAX('Balance Sheet'[period_end]),
        'Balance Sheet'[is_latest_filing] = TRUE()
    )
RETURN
CALCULATE(
    SUM('Balance Sheet'[value_usd]),
    'Balance Sheet'[concept] IN { "OperatingLeaseLiabilityCurrent", "OperatingLeaseLiabilityNoncurrent" },
    'Balance Sheet'[is_latest_filing] = TRUE(),
    'Balance Sheet'[period_end] = _end
)
