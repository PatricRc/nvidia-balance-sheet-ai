// R&D Expense
// Table: Balance Sheet
// Display folder: 02-kpi
// Format: #,##0
// Hidden: false
// Duration ResearchAndDevelopmentExpense at the latest period_end (is_latest_filing).

R&D Expense =
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
RETURN
CALCULATE(
    SUM('Income Statement'[value_usd]),
    'Income Statement'[concept] = "ResearchAndDevelopmentExpense",
    'Income Statement'[is_latest_filing] = TRUE(),
    'Income Statement'[period_end] = _end
)
