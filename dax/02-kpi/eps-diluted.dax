// EPS Diluted
// Table: _Measures
// Display folder: Category\02 KPI\Income Statement;Pages\05 Financial Statements
// Format: 0.00
// Hidden: false
// Duration EarningsPerShareDiluted (USD/shares) at the latest period_end (is_latest_filing).

EPS Diluted =
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
RETURN
CALCULATE(
    SUM('Income Statement'[value_usd]),
    'Income Statement'[concept] = "EarningsPerShareDiluted",
    'Income Statement'[is_latest_filing] = TRUE(),
    'Income Statement'[period_end] = _end
)
