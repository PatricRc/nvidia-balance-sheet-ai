// Current Liabilities
// Table: _Measures
// Display folder: Category\02 KPI\Balance Sheet;Pages\01 Financial Position;Pages\04 Notes & Evidence;Pages\05 Financial Statements
// Format: #,##0
// Hidden: false
// Point-in-time LiabilitiesCurrent at the latest period_end (is_latest_filing).

Current Liabilities =
VAR _end =
    CALCULATE(
        MAX('Balance Sheet'[period_end]),
        'Balance Sheet'[is_latest_filing] = TRUE()
    )
RETURN
CALCULATE(
    SUM('Balance Sheet'[value_usd]),
    'Balance Sheet'[concept] = "LiabilitiesCurrent",
    'Balance Sheet'[is_latest_filing] = TRUE(),
    'Balance Sheet'[period_end] = _end
)
