// Gross Profit
// Table: _Measures
// Display folder: Category\02 KPI\Income Statement;Pages\05 Financial Statements
// Format: #,##0
// Hidden: false
// Duration GrossProfit at the latest period_end (is_latest_filing). Not a sum of quarters.

Gross Profit =
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
RETURN
CALCULATE(
    SUM('Income Statement'[value_usd]),
    'Income Statement'[concept] = "GrossProfit",
    'Income Statement'[is_latest_filing] = TRUE(),
    'Income Statement'[period_end] = _end
)
