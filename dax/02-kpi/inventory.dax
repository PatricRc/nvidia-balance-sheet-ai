// Inventory
// Table: Balance Sheet
// Display folder: 02-kpi
// Format: #,##0
// Hidden: false
// Point-in-time InventoryNet at the latest period_end (is_latest_filing).

Inventory =
VAR _end =
    CALCULATE(
        MAX('Balance Sheet'[period_end]),
        'Balance Sheet'[is_latest_filing] = TRUE()
    )
RETURN
CALCULATE(
    SUM('Balance Sheet'[value_usd]),
    'Balance Sheet'[concept] = "InventoryNet",
    'Balance Sheet'[is_latest_filing] = TRUE(),
    'Balance Sheet'[period_end] = _end
)
