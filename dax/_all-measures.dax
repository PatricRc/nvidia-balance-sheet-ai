// TTM Revenue
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: #,##0
// Hidden: false
// Trailing four standalone fiscal quarters of Revenue ending at the latest period in context ([Revenue Standalone Quarter], so Q4 = FY − Q1 − Q2 − Q3). BLANK unless all four quarters exist. If the current period is the annual 10-K (FY or duration > 300 days), this equals [Revenue].

TTM Revenue =
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
VAR _fp =
    CALCULATE(
        MAX('Income Statement'[fiscal_period]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
VAR _days =
    CALCULATE(
        MAX('Income Statement'[duration_days]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
VAR _annual = _fp = "FY" || _days > 300
VAR _q_ends =
    TOPN(
        4,
        CALCULATETABLE(
            VALUES('Date'[date]),
            REMOVEFILTERS('Date'),
            'Date'[is_fiscal_quarter_end] = TRUE(),
            'Date'[date] <= _end
        ),
        'Date'[date], DESC
    )
VAR _quarters =
    ADDCOLUMNS(
        _q_ends,
        "@v",
            VAR _d = 'Date'[date]
            RETURN CALCULATE([Revenue Standalone Quarter], REMOVEFILTERS('Date'), 'Date'[date] = _d)
    )
VAR _n = COUNTROWS(FILTER(_quarters, NOT ISBLANK([@v])))
RETURN
IF(
    ISBLANK(_end),
    BLANK(),
    IF(_annual, [Revenue], IF(_n = 4, SUMX(_quarters, [@v])))
)

// TTM Net Income
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: #,##0
// Hidden: false
// Trailing four standalone fiscal quarters of Net Income ending at the latest period in context ([Net Income Standalone Quarter], so Q4 = FY − Q1 − Q2 − Q3). BLANK unless all four quarters exist. If the current period is the annual 10-K (FY or duration > 300 days), this equals [Net Income].

TTM Net Income =
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
VAR _fp =
    CALCULATE(
        MAX('Income Statement'[fiscal_period]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
VAR _days =
    CALCULATE(
        MAX('Income Statement'[duration_days]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
VAR _annual = _fp = "FY" || _days > 300
VAR _q_ends =
    TOPN(
        4,
        CALCULATETABLE(
            VALUES('Date'[date]),
            REMOVEFILTERS('Date'),
            'Date'[is_fiscal_quarter_end] = TRUE(),
            'Date'[date] <= _end
        ),
        'Date'[date], DESC
    )
VAR _quarters =
    ADDCOLUMNS(
        _q_ends,
        "@v",
            VAR _d = 'Date'[date]
            RETURN CALCULATE([Net Income Standalone Quarter], REMOVEFILTERS('Date'), 'Date'[date] = _d)
    )
VAR _n = COUNTROWS(FILTER(_quarters, NOT ISBLANK([@v])))
RETURN
IF(
    ISBLANK(_end),
    BLANK(),
    IF(_annual, [Net Income], IF(_n = 4, SUMX(_quarters, [@v])))
)

// Revenue CAGR 3Y
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: 0.0%
// Hidden: false
// 3-year compound annual growth of fiscal-year Revenue for the latest COMPLETED fiscal year on or before the latest period in context: (Rev_FY / Rev_FY-3)^(1/3) − 1. An in-progress year (latest period is a 10-Q) uses the prior completed FY. BLANK when either year is missing.

Revenue CAGR 3Y =
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
VAR _fy =
    CALCULATE(
        MAX('Date'[fiscal_year]),
        REMOVEFILTERS('Date'),
        'Date'[is_fiscal_year_end] = TRUE(),
        'Date'[date] <= _end
    )
VAR _curr =
    CALCULATE(
        [Revenue],
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _fy,
        'Date'[is_fiscal_year_end] = TRUE()
    )
VAR _base =
    CALCULATE(
        [Revenue],
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _fy - 3,
        'Date'[is_fiscal_year_end] = TRUE()
    )
RETURN
IF(
    ISBLANK(_curr) || ISBLANK(_base) || _base <= 0,
    BLANK(),
    POWER(DIVIDE(_curr, _base), 1 / 3) - 1
)

// Revenue CAGR 5Y
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: 0.0%
// Hidden: false
// 5-year compound annual growth of fiscal-year Revenue for the latest COMPLETED fiscal year on or before the latest period in context: (Rev_FY / Rev_FY-5)^(1/5) − 1. An in-progress year (latest period is a 10-Q) uses the prior completed FY. BLANK when either year is missing.

Revenue CAGR 5Y =
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
VAR _fy =
    CALCULATE(
        MAX('Date'[fiscal_year]),
        REMOVEFILTERS('Date'),
        'Date'[is_fiscal_year_end] = TRUE(),
        'Date'[date] <= _end
    )
VAR _curr =
    CALCULATE(
        [Revenue],
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _fy,
        'Date'[is_fiscal_year_end] = TRUE()
    )
VAR _base =
    CALCULATE(
        [Revenue],
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _fy - 5,
        'Date'[is_fiscal_year_end] = TRUE()
    )
RETURN
IF(
    ISBLANK(_curr) || ISBLANK(_base) || _base <= 0,
    BLANK(),
    POWER(DIVIDE(_curr, _base), 1 / 5) - 1
)

// Common Size %
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: 0.0%
// Hidden: false
// Selected Line Item amount at the latest period_end (is_latest_filing) as a % of Revenue (income statement and cash flow) or Total Assets (balance sheet). Requires a single selected line item.

Common Size % =
VAR _stmt = SELECTEDVALUE('Line Item'[statement])
VAR _concept = SELECTEDVALUE('Line Item'[concept])
VAR _end =
    SWITCH(
        _stmt,
        "balance_sheet",
            CALCULATE(MAX('Balance Sheet'[period_end]), 'Balance Sheet'[is_latest_filing] = TRUE()),
        "income_statement",
            CALCULATE(MAX('Income Statement'[period_end]), 'Income Statement'[is_latest_filing] = TRUE()),
        "cash_flow",
            CALCULATE(MAX('Cash Flow'[period_end]), 'Cash Flow'[is_latest_filing] = TRUE())
    )
VAR _amt =
    SWITCH(
        _stmt,
        "balance_sheet",
            CALCULATE(
                SUM('Balance Sheet'[value_usd]),
                'Balance Sheet'[concept] = _concept,
                'Balance Sheet'[is_latest_filing] = TRUE(),
                'Balance Sheet'[period_end] = _end
            ),
        "income_statement",
            CALCULATE(
                SUM('Income Statement'[value_usd]),
                'Income Statement'[concept] = _concept,
                'Income Statement'[is_latest_filing] = TRUE(),
                'Income Statement'[period_end] = _end
            ),
        "cash_flow",
            CALCULATE(
                SUM('Cash Flow'[value_usd]),
                'Cash Flow'[concept] = _concept,
                'Cash Flow'[is_latest_filing] = TRUE(),
                'Cash Flow'[period_end] = _end
            )
    )
VAR _base =
    SWITCH(
        _stmt,
        "balance_sheet", [Total Assets],
        "income_statement", [Revenue],
        "cash_flow", [Revenue]
    )
RETURN
DIVIDE(_amt, _base)

// DuPont ROE
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: 0.0%
// Hidden: false
// DuPont decomposition: Net Margin × Asset Turnover × Equity Multiplier. With average balances this equals [ROE].

DuPont ROE =
[Net Margin %] * [Asset Turnover] * [Equity Multiplier]

// DuPont Check
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: 0.0000%
// Hidden: false
// DuPont ROE minus ROE. Should be ~0 when averages are used consistently. A material value signals a filter or missing-balance issue.

DuPont Check =
[DuPont ROE] - [ROE]
