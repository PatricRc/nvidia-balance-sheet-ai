    )
VAR _prior =
    CALCULATE(
        [Total Equity],
        REMOVEFILTERS('Date'),
        'Date'[date] = _prior_end
    )
RETURN
DIVIDE(_curr - _prior, _prior)

// Cash YoY Change
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: #,##0
// Hidden: false
// Cash minus the same NVIDIA fiscal quarter in the prior fiscal year (Date[fiscal_year]/[fiscal_quarter] quarter-end). Not SAMEPERIODLASTYEAR.

Cash YoY Change =
VAR _end =
    CALCULATE(
        MAX('Balance Sheet'[period_end]),
        'Balance Sheet'[is_latest_filing] = TRUE()
    )
VAR _curr = [Cash]
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _prior_end =
    CALCULATE(
        MAX('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _fy - 1,
        'Date'[fiscal_quarter] = _fq,
        'Date'[is_fiscal_quarter_end] = TRUE()
    )
VAR _prior =
    CALCULATE(
        [Cash],
        REMOVEFILTERS('Date'),
        'Date'[date] = _prior_end
    )
RETURN
_curr - _prior

// Cash YoY %
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: 0.0%
// Hidden: false
// YoY change in Cash as a % of the prior fiscal-year same quarter. Uses fiscal calendar, not SAMEPERIODLASTYEAR.

Cash YoY % =
VAR _end =
    CALCULATE(
        MAX('Balance Sheet'[period_end]),
        'Balance Sheet'[is_latest_filing] = TRUE()
    )
VAR _curr = [Cash]
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _prior_end =
    CALCULATE(
        MAX('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _fy - 1,
        'Date'[fiscal_quarter] = _fq,
        'Date'[is_fiscal_quarter_end] = TRUE()
    )
VAR _prior =
    CALCULATE(
        [Cash],
        REMOVEFILTERS('Date'),
        'Date'[date] = _prior_end
    )
RETURN
DIVIDE(_curr - _prior, _prior)

// Cash QoQ Change
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: #,##0
// Hidden: false
// Cash minus the prior fiscal quarter (Q1 wraps to prior FY Q4). Point-in-time; valid at fiscal year-end (Q4 vs Q3).

Cash QoQ Change =
VAR _end =
    CALCULATE(
        MAX('Balance Sheet'[period_end]),
        'Balance Sheet'[is_latest_filing] = TRUE()
    )
VAR _curr = [Cash]
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _prior_fy = IF(_fq = 1, _fy - 1, _fy)
VAR _prior_fq = IF(_fq = 1, 4, _fq - 1)
VAR _prior_end =
    CALCULATE(
        MAX('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _prior_fy,
        'Date'[fiscal_quarter] = _prior_fq,
        'Date'[is_fiscal_quarter_end] = TRUE()
    )
VAR _prior =
    CALCULATE(
        [Cash],
        REMOVEFILTERS('Date'),
        'Date'[date] = _prior_end
    )
RETURN
_curr - _prior

// Cash QoQ %
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: 0.0%
// Hidden: false
// QoQ change in Cash as a % of the prior fiscal quarter.

Cash QoQ % =
VAR _end =
    CALCULATE(
        MAX('Balance Sheet'[period_end]),
        'Balance Sheet'[is_latest_filing] = TRUE()
    )
VAR _curr = [Cash]
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _prior_fy = IF(_fq = 1, _fy - 1, _fy)
VAR _prior_fq = IF(_fq = 1, 4, _fq - 1)
VAR _prior_end =
    CALCULATE(
        MAX('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _prior_fy,
        'Date'[fiscal_quarter] = _prior_fq,
        'Date'[is_fiscal_quarter_end] = TRUE()
    )
VAR _prior =
    CALCULATE(
        [Cash],
        REMOVEFILTERS('Date'),
        'Date'[date] = _prior_end
    )
RETURN
DIVIDE(_curr - _prior, _prior)

// TTM Revenue
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: #,##0
// Hidden: false
// Trailing four standalone fiscal quarters of Revenue. Q4 is derived as FY − Q1 − Q2 − Q3 only when those three quarters are present, is_latest_filing, and not is_ytd. If the current period is the annual 10-K (FY or duration > 300 days), this equals [Revenue].

TTM Revenue =
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _fp =
    CALCULATE(
        MAX('Income Statement'[fiscal_period]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
VAR _days =
    CALCULATE(
        MAX('Income Statement'[duration_days]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
VAR _annual = _fp = "FY" || _days > 300
VAR _q0_fy = _fy
VAR _q0_fq = _fq
VAR _q1_fy = IF(_q0_fq = 1, _q0_fy - 1, _q0_fy)
VAR _q1_fq = IF(_q0_fq = 1, 4, _q0_fq - 1)
VAR _q2_fy = IF(_q1_fq = 1, _q1_fy - 1, _q1_fy)
VAR _q2_fq = IF(_q1_fq = 1, 4, _q1_fq - 1)
VAR _q3_fy = IF(_q2_fq = 1, _q2_fy - 1, _q2_fy)
VAR _q3_fq = IF(_q2_fq = 1, 4, _q2_fq - 1)
VAR _pairs =
    UNION(
        ROW("fy", _q0_fy, "fq", _q0_fq),
        ROW("fy", _q1_fy, "fq", _q1_fq),
        ROW("fy", _q2_fy, "fq", _q2_fq),
        ROW("fy", _q3_fy, "fq", _q3_fq)
    )
VAR _ttm =
    SUMX(
        _pairs,
        VAR _y = [fy]
        VAR _q = [fq]
        VAR _qtr =
            IF(
                _q < 4,
                CALCULATE(
                    [Revenue],
                    REMOVEFILTERS('Date'),
                    'Income Statement'[fiscal_year] = _y,
                    'Income Statement'[fiscal_period] = "Q" & _q,
                    'Income Statement'[is_latest_filing] = TRUE(),
                    'Income Statement'[is_ytd] = FALSE()
                ),
                VAR _ann =
                    CALCULATE(
                        [Revenue],
                        REMOVEFILTERS('Date'),
                        'Income Statement'[fiscal_year] = _y,
                        'Income Statement'[fiscal_period] = "FY",
                        'Income Statement'[is_latest_filing] = TRUE()
                    )
                VAR _qa =
                    CALCULATE(
                        [Revenue],
                        REMOVEFILTERS('Date'),
                        'Income Statement'[fiscal_year] = _y,
                        'Income Statement'[fiscal_period] = "Q1",
                        'Income Statement'[is_latest_filing] = TRUE(),
                        'Income Statement'[is_ytd] = FALSE()
                    )
                VAR _qb =
                    CALCULATE(
                        [Revenue],
                        REMOVEFILTERS('Date'),
                        'Income Statement'[fiscal_year] = _y,
                        'Income Statement'[fiscal_period] = "Q2",
                        'Income Statement'[is_latest_filing] = TRUE(),
                        'Income Statement'[is_ytd] = FALSE()
                    )
                VAR _qc =
                    CALCULATE(
                        [Revenue],
                        REMOVEFILTERS('Date'),
                        'Income Statement'[fiscal_year] = _y,
                        'Income Statement'[fiscal_period] = "Q3",
                        'Income Statement'[is_latest_filing] = TRUE(),
                        'Income Statement'[is_ytd] = FALSE()
                    )
                RETURN
                IF(
                    ISBLANK(_ann) || ISBLANK(_qa) || ISBLANK(_qb) || ISBLANK(_qc),
                    BLANK(),
                    _ann - _qa - _qb - _qc
                )
            )
        RETURN
        _qtr
    )
RETURN
IF(_annual, [Revenue], _ttm)

// TTM Net Income
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: #,##0
// Hidden: false
// Trailing four standalone fiscal quarters of Net Income. Q4 is derived as FY − Q1 − Q2 − Q3 only when those quarters are present, is_latest_filing, and not is_ytd. If the current period is the annual 10-K, this equals [Net Income].

TTM Net Income =
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _fp =
    CALCULATE(
        MAX('Income Statement'[fiscal_period]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
VAR _days =
    CALCULATE(
        MAX('Income Statement'[duration_days]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
VAR _annual = _fp = "FY" || _days > 300
VAR _q0_fy = _fy
VAR _q0_fq = _fq
VAR _q1_fy = IF(_q0_fq = 1, _q0_fy - 1, _q0_fy)
VAR _q1_fq = IF(_q0_fq = 1, 4, _q0_fq - 1)
VAR _q2_fy = IF(_q1_fq = 1, _q1_fy - 1, _q1_fy)
VAR _q2_fq = IF(_q1_fq = 1, 4, _q1_fq - 1)
VAR _q3_fy = IF(_q2_fq = 1, _q2_fy - 1, _q2_fy)
VAR _q3_fq = IF(_q2_fq = 1, 4, _q2_fq - 1)
VAR _pairs =
    UNION(
        ROW("fy", _q0_fy, "fq", _q0_fq),
        ROW("fy", _q1_fy, "fq", _q1_fq),
        ROW("fy", _q2_fy, "fq", _q2_fq),
        ROW("fy", _q3_fy, "fq", _q3_fq)
    )
VAR _ttm =
    SUMX(
        _pairs,
        VAR _y = [fy]
        VAR _q = [fq]
        VAR _qtr =
            IF(
                _q < 4,
                CALCULATE(
                    [Net Income],
                    REMOVEFILTERS('Date'),
                    'Income Statement'[fiscal_year] = _y,
                    'Income Statement'[fiscal_period] = "Q" & _q,
                    'Income Statement'[is_latest_filing] = TRUE(),
                    'Income Statement'[is_ytd] = FALSE()
                ),
                VAR _ann =
                    CALCULATE(
                        [Net Income],
                        REMOVEFILTERS('Date'),
                        'Income Statement'[fiscal_year] = _y,
                        'Income Statement'[fiscal_period] = "FY",
                        'Income Statement'[is_latest_filing] = TRUE()
                    )
                VAR _qa =
                    CALCULATE(
                        [Net Income],
                        REMOVEFILTERS('Date'),
                        'Income Statement'[fiscal_year] = _y,
                        'Income Statement'[fiscal_period] = "Q1",
                        'Income Statement'[is_latest_filing] = TRUE(),
                        'Income Statement'[is_ytd] = FALSE()
                    )
                VAR _qb =
                    CALCULATE(
                        [Net Income],
                        REMOVEFILTERS('Date'),
                        'Income Statement'[fiscal_year] = _y,
                        'Income Statement'[fiscal_period] = "Q2",
                        'Income Statement'[is_latest_filing] = TRUE(),
                        'Income Statement'[is_ytd] = FALSE()
                    )
                VAR _qc =
                    CALCULATE(
                        [Net Income],
                        REMOVEFILTERS('Date'),
                        'Income Statement'[fiscal_year] = _y,
                        'Income Statement'[fiscal_period] = "Q3",
                        'Income Statement'[is_latest_filing] = TRUE(),
                        'Income Statement'[is_ytd] = FALSE()
                    )
                RETURN
                IF(
                    ISBLANK(_ann) || ISBLANK(_qa) || ISBLANK(_qb) || ISBLANK(_qc),
                    BLANK(),
                    _ann - _qa - _qb - _qc
                )
            )
        RETURN
        _qtr
    )
RETURN
IF(_annual, [Net Income], _ttm)

// Revenue CAGR 3Y
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: 0.0%
// Hidden: false
// 3-year compound annual growth of fiscal-year Revenue: (Rev_FY / Rev_FY-3)^(1/3) − 1. Always uses annual (fiscal year-end) Revenue, not a quarterly figure.

Revenue CAGR 3Y =
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _curr =
    CALCULATE(
        [Revenue],
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _fy,
        'Date'[is_fiscal_year_end] = TRUE()
    )
VAR _base =
    CALCULATE(
        [Revenue],
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _fy - 3,
        'Date'[is_fiscal_year_end] = TRUE()
    )
RETURN
POWER(DIVIDE(_curr, _base), 1 / 3) - 1

// Revenue CAGR 5Y
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: 0.0%
// Hidden: false
// 5-year compound annual growth of fiscal-year Revenue: (Rev_FY / Rev_FY-5)^(1/5) − 1. Always uses annual (fiscal year-end) Revenue. [Revenue] already coalesces Revenues and RevenueFromContractWithCustomerExcludingAssessedTax.

Revenue CAGR 5Y =
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _curr =
    CALCULATE(
        [Revenue],
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _fy,
        'Date'[is_fiscal_year_end] = TRUE()
    )
VAR _base =
    CALCULATE(
        [Revenue],
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _fy - 5,
        'Date'[is_fiscal_year_end] = TRUE()
    )
RETURN
POWER(DIVIDE(_curr, _base), 1 / 5) - 1

// Common Size %
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: 0.0%
// Hidden: false
// Selected Line Item amount at the latest period_end (is_latest_filing) as a % of Revenue (income statement and cash flow) or Total Assets (balance sheet). Requires a single selected line item.

Common Size % =
VAR _stmt = SELECTEDVALUE('Line Item'[statement])
VAR _concept = SELECTEDVALUE('Line Item'[concept])
VAR _end =
    SWITCH(
        _stmt,
        "balance_sheet",
            CALCULATE(MAX('Balance Sheet'[period_end]), 'Balance Sheet'[is_latest_filing] = TRUE()),
        "income_statement",
            CALCULATE(MAX('Income Statement'[period_end]), 'Income Statement'[is_latest_filing] = TRUE()),
        "cash_flow",
            CALCULATE(MAX('Cash Flow'[period_end]), 'Cash Flow'[is_latest_filing] = TRUE())
    )
VAR _amt =
    SWITCH(
        _stmt,
        "balance_sheet",
            CALCULATE(
                SUM('Balance Sheet'[value_usd]),
                'Balance Sheet'[concept] = _concept,
                'Balance Sheet'[is_latest_filing] = TRUE(),
                'Balance Sheet'[period_end] = _end
            ),
        "income_statement",
            CALCULATE(
                SUM('Income Statement'[value_usd]),
                'Income Statement'[concept] = _concept,
                'Income Statement'[is_latest_filing] = TRUE(),
                'Income Statement'[period_end] = _end
            ),
        "cash_flow",
            CALCULATE(
                SUM('Cash Flow'[value_usd]),
                'Cash Flow'[concept] = _concept,
                'Cash Flow'[is_latest_filing] = TRUE(),
                'Cash Flow'[period_end] = _end
            )
    )
VAR _base =
    SWITCH(
        _stmt,
        "balance_sheet", [Total Assets],
        "income_statement", [Revenue],
        "cash_flow", [Revenue]
    )
RETURN
DIVIDE(_amt, _base)

// DuPont ROE
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: 0.0%
// Hidden: false
// DuPont decomposition: Net Margin × Asset Turnover × Equity Multiplier. With average balances this equals [ROE].

DuPont ROE =
[Net Margin %] * [Asset Turnover] * [Equity Multiplier]

// DuPont Check
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: 0.0000%
// Hidden: false
// DuPont ROE minus ROE. Should be ~0 when averages are used consistently. A material value signals a filter or missing-balance issue.

DuPont Check =
[DuPont ROE] - [ROE]
