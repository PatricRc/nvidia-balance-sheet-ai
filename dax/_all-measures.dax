// Average Assets
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: #,##0
// Hidden: false
// Average of current and prior fiscal-quarter-end Total Assets (prior quarter wraps Q1 → prior FY Q4). If the prior balance is missing, uses ending Total Assets.

Average Assets =
VAR _end =
    CALCULATE(
        MAX('Balance Sheet'[period_end]),
        'Balance Sheet'[is_latest_filing] = TRUE()
    )
VAR _curr = [Total Assets]
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _prior_fy = IF(_fq = 1, _fy - 1, _fy)
VAR _prior_fq = IF(_fq = 1, 4, _fq - 1)
VAR _prior_end =
    CALCULATE(
        MAX('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _prior_fy,
        'Date'[fiscal_quarter] = _prior_fq,
        'Date'[is_fiscal_quarter_end] = TRUE()
    )
VAR _prior =
    CALCULATE(
        [Total Assets],
        REMOVEFILTERS('Date'),
        'Date'[date] = _prior_end
    )
RETURN
IF(ISBLANK(_prior), _curr, DIVIDE(_curr + _prior, 2))

// Average Equity
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: #,##0
// Hidden: false
// Average of current and prior fiscal-quarter-end Total Equity (Q1 wraps to prior FY Q4). If the prior balance is missing, uses ending Total Equity.

Average Equity =
VAR _end =
    CALCULATE(
        MAX('Balance Sheet'[period_end]),
        'Balance Sheet'[is_latest_filing] = TRUE()
    )
VAR _curr = [Total Equity]
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _prior_fy = IF(_fq = 1, _fy - 1, _fy)
VAR _prior_fq = IF(_fq = 1, 4, _fq - 1)
VAR _prior_end =
    CALCULATE(
        MAX('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _prior_fy,
        'Date'[fiscal_quarter] = _prior_fq,
        'Date'[is_fiscal_quarter_end] = TRUE()
    )
VAR _prior =
    CALCULATE(
        [Total Equity],
        REMOVEFILTERS('Date'),
        'Date'[date] = _prior_end
    )
RETURN
IF(ISBLANK(_prior), _curr, DIVIDE(_curr + _prior, 2))

// Average Inventory
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: #,##0
// Hidden: false
// Average of current and prior fiscal-quarter-end Inventory. Falls back to ending Inventory if the prior period is missing.

Average Inventory =
VAR _end =
    CALCULATE(
        MAX('Balance Sheet'[period_end]),
        'Balance Sheet'[is_latest_filing] = TRUE()
    )
VAR _curr = [Inventory]
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _prior_fy = IF(_fq = 1, _fy - 1, _fy)
VAR _prior_fq = IF(_fq = 1, 4, _fq - 1)
VAR _prior_end =
    CALCULATE(
        MAX('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _prior_fy,
        'Date'[fiscal_quarter] = _prior_fq,
        'Date'[is_fiscal_quarter_end] = TRUE()
    )
VAR _prior =
    CALCULATE(
        [Inventory],
        REMOVEFILTERS('Date'),
        'Date'[date] = _prior_end
    )
RETURN
IF(ISBLANK(_prior), _curr, DIVIDE(_curr + _prior, 2))

// Average Receivables
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: #,##0
// Hidden: false
// Average of current and prior fiscal-quarter-end Accounts Receivable. Falls back to ending AR if the prior period is missing.

Average Receivables =
VAR _end =
    CALCULATE(
        MAX('Balance Sheet'[period_end]),
        'Balance Sheet'[is_latest_filing] = TRUE()
    )
VAR _curr = [Accounts Receivable]
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _prior_fy = IF(_fq = 1, _fy - 1, _fy)
VAR _prior_fq = IF(_fq = 1, 4, _fq - 1)
VAR _prior_end =
    CALCULATE(
        MAX('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _prior_fy,
        'Date'[fiscal_quarter] = _prior_fq,
        'Date'[is_fiscal_quarter_end] = TRUE()
    )
VAR _prior =
    CALCULATE(
        [Accounts Receivable],
        REMOVEFILTERS('Date'),
        'Date'[date] = _prior_end
    )
RETURN
IF(ISBLANK(_prior), _curr, DIVIDE(_curr + _prior, 2))

// Period Days
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: #,##0.0
// Hidden: true
// Duration_days of the latest income-statement period (is_latest_filing); 365 if blank. Used as the day count for DIO/DSO (NVIDIA FY is typically 363, not 365).

Period Days =
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
VAR _days =
    CALCULATE(
        MAX('Income Statement'[duration_days]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
RETURN
COALESCE(_days, 365)

// Gross Margin %
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.0%
// Hidden: false
// Gross Profit / Revenue for the latest period in context.

Gross Margin % =
DIVIDE([Gross Profit], [Revenue])

// Operating Margin %
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.0%
// Hidden: false
// Operating Income / Revenue for the latest period in context.

Operating Margin % =
DIVIDE([Operating Income], [Revenue])

// Net Margin %
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.0%
// Hidden: false
// Net Income / Revenue for the latest period in context. Same definition as 01-base [Net Income Margin %].

Net Margin % =
DIVIDE([Net Income], [Revenue])

// R&D % of Revenue
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.0%
// Hidden: false
// R&D Expense / Revenue for the latest period in context.

R&D % of Revenue =
DIVIDE([R&D Expense], [Revenue])

// ROE
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.0%
// Hidden: false
// Net Income / Average Equity. Average is (ending + prior fiscal-quarter-end) / 2, or ending if prior is missing. Not annualized in a quarterly context.

ROE =
DIVIDE([Net Income], [Average Equity])

// ROA
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.0%
// Hidden: false
// Net Income / Average Assets. Average is (ending + prior fiscal-quarter-end) / 2, or ending if prior is missing. Not annualized in a quarterly context.

ROA =
DIVIDE([Net Income], [Average Assets])

// Current Ratio
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.00
// Hidden: false
// Current Assets / Current Liabilities (point-in-time, latest period).

Current Ratio =
DIVIDE([Current Assets], [Current Liabilities])

// Quick Ratio
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.00
// Hidden: false
//  (Cash + Marketable Securities + Accounts Receivable) / Current Liabilities. A missing Marketable Securities amount is treated as 0 (DAX BLANK in addition).

Quick Ratio =
DIVIDE([Cash] + [Marketable Securities] + [Accounts Receivable], [Current Liabilities])

// Cash Ratio
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.00
// Hidden: false
// Cash / Current Liabilities (point-in-time, latest period).

Cash Ratio =
DIVIDE([Cash], [Current Liabilities])

// Liabilities to Assets
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.00
// Hidden: false
// Total Liabilities / Total Assets (point-in-time, latest period).

Liabilities to Assets =
DIVIDE([Total Liabilities], [Total Assets])

// Equity Multiplier
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.00x
// Hidden: false
// Average Assets / Average Equity (same average convention as ROE/ROA, so DuPont tiles).

Equity Multiplier =
DIVIDE([Average Assets], [Average Equity])

// Asset Turnover
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.00x
// Hidden: false
// Revenue / Average Assets (same average convention as ROA).

Asset Turnover =
DIVIDE([Revenue], [Average Assets])

// Inventory Turnover
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.00x
// Hidden: false
// Cost of Revenue / Average Inventory.

Inventory Turnover =
DIVIDE([Cost of Revenue], [Average Inventory])

// DIO
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: #,##0.0
// Hidden: false
// Days inventory outstanding: Period Days × Average Inventory / Cost of Revenue. Period Days is the filing duration (not a fixed 365).

DIO =
DIVIDE([Period Days] * [Average Inventory], [Cost of Revenue])

// DSO
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: #,##0.0
// Hidden: false
// Days sales outstanding: Period Days × Average Receivables / Revenue. Period Days is the filing duration (not a fixed 365).

DSO =
DIVIDE([Period Days] * [Average Receivables], [Revenue])

// CFO to Net Income
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.00
// Hidden: false
// Operating Cash Flow / Net Income (cash conversion). Meaningful when both are annual or the same window; if [Cash Flow Is YTD] and income is a standalone quarter, the ratio mixes YTD cash with quarterly earnings — treat as blank for analysis in that case is left to the report (the measure still computes).

CFO to Net Income =
DIVIDE([Operating Cash Flow], [Net Income])

// Revenue YoY Change
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: #,##0
// Hidden: false
// Revenue minus the same NVIDIA fiscal quarter in the prior fiscal year (Date[fiscal_year]/[fiscal_quarter] quarter-end). Not SAMEPERIODLASTYEAR.

Revenue YoY Change =
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
VAR _curr = [Revenue]
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _prior_end =
    CALCULATE(
        MAX('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _fy - 1,
        'Date'[fiscal_quarter] = _fq,
        'Date'[is_fiscal_quarter_end] = TRUE()
    )
VAR _prior =
    CALCULATE(
        [Revenue],
        REMOVEFILTERS('Date'),
        'Date'[date] = _prior_end
    )
RETURN
_curr - _prior

// Revenue QoQ Change
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: #,##0
// Hidden: false
// Revenue minus the prior fiscal quarter (Q1 wraps to prior FY Q4). BLANK when the latest period is the annual 10-K (FY / duration > 300 days), so annual totals are not compared to a quarter.

Revenue QoQ Change =
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
VAR _curr = [Revenue]
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _fp =
    CALCULATE(
        MAX('Income Statement'[fiscal_period]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
VAR _days =
    CALCULATE(
        MAX('Income Statement'[duration_days]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
VAR _annual = _fp = "FY" || _days > 300
VAR _prior_fy = IF(_fq = 1, _fy - 1, _fy)
VAR _prior_fq = IF(_fq = 1, 4, _fq - 1)
VAR _prior_end =
    CALCULATE(
        MAX('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _prior_fy,
        'Date'[fiscal_quarter] = _prior_fq,
        'Date'[is_fiscal_quarter_end] = TRUE()
    )
VAR _prior =
    CALCULATE(
        [Revenue],
        REMOVEFILTERS('Date'),
        'Date'[date] = _prior_end
    )
RETURN
IF(_annual, BLANK(), _curr - _prior)

// Revenue QoQ %
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: 0.0%
// Hidden: false
// QoQ change in Revenue as a % of the prior fiscal quarter. BLANK when the latest period is annual.

Revenue QoQ % =
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
VAR _curr = [Revenue]
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _fp =
    CALCULATE(
        MAX('Income Statement'[fiscal_period]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
VAR _days =
    CALCULATE(
        MAX('Income Statement'[duration_days]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
VAR _annual = _fp = "FY" || _days > 300
VAR _prior_fy = IF(_fq = 1, _fy - 1, _fy)
VAR _prior_fq = IF(_fq = 1, 4, _fq - 1)
VAR _prior_end =
    CALCULATE(
        MAX('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _prior_fy,
        'Date'[fiscal_quarter] = _prior_fq,
        'Date'[is_fiscal_quarter_end] = TRUE()
    )
VAR _prior =
    CALCULATE(
        [Revenue],
        REMOVEFILTERS('Date'),
        'Date'[date] = _prior_end
    )
RETURN
IF(_annual, BLANK(), DIVIDE(_curr - _prior, _prior))

