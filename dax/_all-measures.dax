    'Cash Flow'[period_end] = _end
)

// Long-Term Debt Current
// Table: Balance Sheet
// Display folder: 02-kpi
// Format: #,##0
// Hidden: false
// Point-in-time LongTermDebtCurrent (current portion of long-term debt) at the latest period_end (is_latest_filing). Tagged by NVIDIA from FY2020; earlier periods are BLANK.

Long-Term Debt Current =
VAR _end =
    CALCULATE(
        MAX('Balance Sheet'[period_end]),
        'Balance Sheet'[is_latest_filing] = TRUE()
    )
RETURN
CALCULATE(
    SUM('Balance Sheet'[value_usd]),
    'Balance Sheet'[concept] = "LongTermDebtCurrent",
    'Balance Sheet'[is_latest_filing] = TRUE(),
    'Balance Sheet'[period_end] = _end
)

// Gross Debt
// Table: Balance Sheet
// Display folder: 02-kpi
// Format: #,##0
// Hidden: false
// Long-Term Debt (noncurrent) + Long-Term Debt Current. Excludes operating lease liabilities (see [Operating Lease Liabilities]). BLANK current portion counts as 0; BLANK when noncurrent debt is BLANK.

Gross Debt =
VAR _lt = [Long-Term Debt]
VAR _cur = [Long-Term Debt Current]
RETURN
IF(ISBLANK(_lt), BLANK(), _lt + COALESCE(_cur, 0))

// Operating Lease Liabilities
// Table: Balance Sheet
// Display folder: 02-kpi
// Format: #,##0
// Hidden: false
// OperatingLeaseLiabilityCurrent + OperatingLeaseLiabilityNoncurrent at the latest period_end (is_latest_filing). Shown separately from debt; never netted into Net Cash.

Operating Lease Liabilities =
VAR _end =
    CALCULATE(
        MAX('Balance Sheet'[period_end]),
        'Balance Sheet'[is_latest_filing] = TRUE()
    )
RETURN
CALCULATE(
    SUM('Balance Sheet'[value_usd]),
    'Balance Sheet'[concept] IN { "OperatingLeaseLiabilityCurrent", "OperatingLeaseLiabilityNoncurrent" },
    'Balance Sheet'[is_latest_filing] = TRUE(),
    'Balance Sheet'[period_end] = _end
)

// Net Cash
// Table: Balance Sheet
// Display folder: 02-kpi
// Format: #,##0
// Hidden: false
// Cash & equivalents + current Marketable Securities − Gross Debt (leases excluded). BLANK when Marketable Securities is not tagged (FY2026 onward) so the figure is never understated; use [Net Cash (Cash Only)] as the conservative fallback.

Net Cash =
VAR _ms = [Marketable Securities]
VAR _debt = [Gross Debt]
RETURN
IF(ISBLANK(_ms) || ISBLANK([Cash]), BLANK(), [Cash] + _ms - COALESCE(_debt, 0))

// Net Cash (Cash Only)
// Table: Balance Sheet
// Display folder: 02-kpi
// Format: #,##0
// Hidden: false
// Conservative net cash: Cash & equivalents − Gross Debt (marketable securities and leases excluded). Always available; label it as cash-only on the canvas.

Net Cash (Cash Only) =
VAR _cash = [Cash]
RETURN
IF(ISBLANK(_cash), BLANK(), _cash - COALESCE([Gross Debt], 0))

// Period Label
// Table: Balance Sheet
// Display folder: 02-kpi
// Format: 
// Hidden: false
// Text label for the latest balance-sheet period in context, e.g. "Q2 FY2027 · ended 2026-07-26" or "FY2026 · ended 2026-01-25". Fiscal labels only — never calendar.

Period Label =
VAR _end =
    CALCULATE(
        MAX('Balance Sheet'[period_end]),
        'Balance Sheet'[is_latest_filing] = TRUE()
    )
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), REMOVEFILTERS('Date'), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), REMOVEFILTERS('Date'), 'Date'[date] = _end)
VAR _is_fy_end =
    CALCULATE(MAXX(VALUES('Date'[is_fiscal_year_end]), IF('Date'[is_fiscal_year_end], 1, 0)), REMOVEFILTERS('Date'), 'Date'[date] = _end) = 1
RETURN
IF(
    ISBLANK(_end),
    BLANK(),
    IF(_is_fy_end, "FY" & _fy, "Q" & _fq & " FY" & _fy) & " · ended " & FORMAT(_end, "yyyy-mm-dd")
)

// Average Assets
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: #,##0
// Hidden: false
// Average of ending and prior-period-end (prior FY end at year grain, prior fiscal quarter end at quarter grain) Total Assets (prior quarter wraps Q1 → prior FY Q4). If the prior balance is missing, uses ending Total Assets.

Average Assets =
VAR _end =
    CALCULATE(
        MAX('Balance Sheet'[period_end]),
        'Balance Sheet'[is_latest_filing] = TRUE()
    )
VAR _curr = [Total Assets]
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _annual =
    DATEDIFF(MIN('Date'[date]), MAX('Date'[date]), DAY) > 120
VAR _prior_fy = IF(_annual || _fq = 1, _fy - 1, _fy)
VAR _prior_fq = IF(_annual || _fq = 1, 4, _fq - 1)
VAR _prior_end =
    CALCULATE(
        MAX('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _prior_fy,
        'Date'[fiscal_quarter] = _prior_fq,
        'Date'[is_fiscal_quarter_end] = TRUE()
    )
VAR _prior =
    CALCULATE(
        [Total Assets],
        REMOVEFILTERS('Date'),
        'Date'[date] = _prior_end
    )
RETURN
IF(ISBLANK(_prior), _curr, DIVIDE(_curr + _prior, 2))

// Average Equity
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: #,##0
// Hidden: false
// Average of ending and prior-period-end (prior FY end at year grain, prior fiscal quarter end at quarter grain) Total Equity (Q1 wraps to prior FY Q4). If the prior balance is missing, uses ending Total Equity.

Average Equity =
VAR _end =
    CALCULATE(
        MAX('Balance Sheet'[period_end]),
        'Balance Sheet'[is_latest_filing] = TRUE()
    )
VAR _curr = [Total Equity]
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _annual =
    DATEDIFF(MIN('Date'[date]), MAX('Date'[date]), DAY) > 120
VAR _prior_fy = IF(_annual || _fq = 1, _fy - 1, _fy)
VAR _prior_fq = IF(_annual || _fq = 1, 4, _fq - 1)
VAR _prior_end =
    CALCULATE(
        MAX('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _prior_fy,
        'Date'[fiscal_quarter] = _prior_fq,
        'Date'[is_fiscal_quarter_end] = TRUE()
    )
VAR _prior =
    CALCULATE(
        [Total Equity],
        REMOVEFILTERS('Date'),
        'Date'[date] = _prior_end
    )
RETURN
IF(ISBLANK(_prior), _curr, DIVIDE(_curr + _prior, 2))

// Average Inventory
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: #,##0
// Hidden: false
// Average of ending and prior-period-end (prior FY end at year grain, prior fiscal quarter end at quarter grain) Inventory. Falls back to ending Inventory if the prior period is missing.

Average Inventory =
VAR _end =
    CALCULATE(
        MAX('Balance Sheet'[period_end]),
        'Balance Sheet'[is_latest_filing] = TRUE()
    )
VAR _curr = [Inventory]
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _annual =
    DATEDIFF(MIN('Date'[date]), MAX('Date'[date]), DAY) > 120
VAR _prior_fy = IF(_annual || _fq = 1, _fy - 1, _fy)
VAR _prior_fq = IF(_annual || _fq = 1, 4, _fq - 1)
VAR _prior_end =
    CALCULATE(
        MAX('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _prior_fy,
        'Date'[fiscal_quarter] = _prior_fq,
        'Date'[is_fiscal_quarter_end] = TRUE()
    )
VAR _prior =
    CALCULATE(
        [Inventory],
        REMOVEFILTERS('Date'),
        'Date'[date] = _prior_end
    )
RETURN
IF(ISBLANK(_prior), _curr, DIVIDE(_curr + _prior, 2))

// Average Receivables
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: #,##0
// Hidden: false
// Average of ending and prior-period-end (prior FY end at year grain, prior fiscal quarter end at quarter grain) Accounts Receivable. Falls back to ending AR if the prior period is missing.

Average Receivables =
VAR _end =
    CALCULATE(
        MAX('Balance Sheet'[period_end]),
        'Balance Sheet'[is_latest_filing] = TRUE()
    )
VAR _curr = [Accounts Receivable]
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _annual =
    DATEDIFF(MIN('Date'[date]), MAX('Date'[date]), DAY) > 120
VAR _prior_fy = IF(_annual || _fq = 1, _fy - 1, _fy)
VAR _prior_fq = IF(_annual || _fq = 1, 4, _fq - 1)
VAR _prior_end =
    CALCULATE(
        MAX('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _prior_fy,
        'Date'[fiscal_quarter] = _prior_fq,
        'Date'[is_fiscal_quarter_end] = TRUE()
    )
VAR _prior =
    CALCULATE(
        [Accounts Receivable],
        REMOVEFILTERS('Date'),
        'Date'[date] = _prior_end
    )
RETURN
IF(ISBLANK(_prior), _curr, DIVIDE(_curr + _prior, 2))

// Period Days
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: #,##0.0
// Hidden: true
// Duration_days of the latest income-statement period (is_latest_filing); 365 if blank. Used as the day count for DIO/DSO (NVIDIA FY is typically 363, not 365).

Period Days =
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
VAR _days =
    CALCULATE(
        MAX('Income Statement'[duration_days]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
RETURN
COALESCE(_days, 365)

// Gross Margin %
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.0%
// Hidden: false
// Gross Profit / Revenue for the latest period in context.

Gross Margin % =
DIVIDE([Gross Profit], [Revenue])

// Operating Margin %
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.0%
// Hidden: false
// Operating Income / Revenue for the latest period in context.

Operating Margin % =
DIVIDE([Operating Income], [Revenue])

// Net Margin %
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.0%
// Hidden: false
// Net Income / Revenue for the latest period in context. Same definition as 01-base [Net Income Margin %].

Net Margin % =
DIVIDE([Net Income], [Revenue])

// R&D % of Revenue
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.0%
// Hidden: false
// R&D Expense / Revenue for the latest period in context.

R&D % of Revenue =
DIVIDE([R&D Expense], [Revenue])

// ROE
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.0%
// Hidden: false
// Net Income / Average Equity. Average is (ending + prior-period-end) / 2, prior FY end at year grain, or ending if prior is missing. Not annualized in a quarterly context.

ROE =
DIVIDE([Net Income], [Average Equity])

// ROA
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.0%
// Hidden: false
// Net Income / Average Assets. Average is (ending + prior-period-end) / 2, prior FY end at year grain, or ending if prior is missing. Not annualized in a quarterly context.

ROA =
DIVIDE([Net Income], [Average Assets])

// Current Ratio
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.00
// Hidden: false
// Current Assets / Current Liabilities (point-in-time, latest period).

Current Ratio =
DIVIDE([Current Assets], [Current Liabilities])

// Quick Ratio
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.00
// Hidden: false
// (Cash + Marketable Securities + Accounts Receivable) / Current Liabilities. BLANK when Marketable Securities is not tagged (FY2026 onward) — treating it as 0 would understate NVIDIA's liquidity by tens of billions.

Quick Ratio =
VAR _ms = [Marketable Securities]
RETURN
IF(
    ISBLANK(_ms),
    BLANK(),
    DIVIDE([Cash] + _ms + [Accounts Receivable], [Current Liabilities])
)

// Cash Ratio
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.00
// Hidden: false
// Cash / Current Liabilities (point-in-time, latest period).

Cash Ratio =
DIVIDE([Cash], [Current Liabilities])

// Liabilities to Assets
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.00
// Hidden: false
// Total Liabilities / Total Assets (point-in-time, latest period).

Liabilities to Assets =
DIVIDE([Total Liabilities], [Total Assets])

// Equity Multiplier
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.00x
// Hidden: false
// Average Assets / Average Equity (same average convention as ROE/ROA, so DuPont tiles).

Equity Multiplier =
DIVIDE([Average Assets], [Average Equity])

// Asset Turnover
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.00x
// Hidden: false
// Revenue / Average Assets (same average convention as ROA).

Asset Turnover =
DIVIDE([Revenue], [Average Assets])

// Inventory Turnover
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.00x
// Hidden: false
// Cost of Revenue / Average Inventory.

Inventory Turnover =
DIVIDE([Cost of Revenue], [Average Inventory])

// DIO
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: #,##0.0
// Hidden: false
// Days inventory outstanding: Period Days × Average Inventory / Cost of Revenue. Period Days is the filing duration (not a fixed 365).

DIO =
DIVIDE([Period Days] * [Average Inventory], [Cost of Revenue])

// DSO
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: #,##0.0
// Hidden: false
// Days sales outstanding: Period Days × Average Receivables / Revenue. Period Days is the filing duration (not a fixed 365).

DSO =
DIVIDE([Period Days] * [Average Receivables], [Revenue])

// CFO to Net Income
// Table: Balance Sheet
// Display folder: 03-ratios
// Format: 0.00
// Hidden: false
// Operating Cash Flow / Net Income (cash conversion) on matching windows only. BLANK when cash flow is 10-Q YTD but Net Income is a standalone quarter (Q2/Q3), so YTD cash is never divided by one quarter of earnings.

CFO to Net Income =
VAR _cf_ytd = [Cash Flow Is YTD]
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
VAR _inc_ytd =
    CALCULATE(
        MAXX(VALUES('Income Statement'[is_ytd]), IF('Income Statement'[is_ytd], 1, 0)),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
RETURN
IF(
    _cf_ytd = 1 && COALESCE(_inc_ytd, 0) = 0,
    BLANK(),
    DIVIDE([Operating Cash Flow], [Net Income])
)

// Revenue Standalone Quarter
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: #,##0
// Hidden: true
// Hidden helper: Revenue for one standalone fiscal quarter. On Q1–Q3 it is [Revenue]; on the FY 10-K it derives Q4 = FY − Q1 − Q2 − Q3 (BLANK unless all three quarters exist). Used by QoQ and TTM so a quarter is never compared to a full year.

Revenue Standalone Quarter =
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _fp =
    CALCULATE(
        MAX('Income Statement'[fiscal_period]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
VAR _days =
    CALCULATE(
        MAX('Income Statement'[duration_days]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
VAR _annual = _fp = "FY" || _days > 300
VAR _fy_end =
    CALCULATE(
        MAX('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _fy,
        'Date'[is_fiscal_year_end] = TRUE()
    )
VAR _q_ends =
    CALCULATETABLE(
        VALUES('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _fy,
        'Date'[fiscal_quarter] IN { 1, 2, 3 },
        'Date'[is_fiscal_quarter_end] = TRUE()
    )
VAR _q123 =
    ADDCOLUMNS(
        _q_ends,
        "@v",
            VAR _d = 'Date'[date]
            RETURN CALCULATE([Revenue], REMOVEFILTERS('Date'), 'Date'[date] = _d)
    )
VAR _n = COUNTROWS(FILTER(_q123, NOT ISBLANK([@v])))
VAR _annual_value =
    CALCULATE([Revenue], REMOVEFILTERS('Date'), 'Date'[date] = _fy_end)
RETURN
IF(
    _annual,
    IF(_n = 3 && NOT ISBLANK(_annual_value), _annual_value - SUMX(_q123, [@v])),
    [Revenue]
)

// Net Income Standalone Quarter
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: #,##0
// Hidden: true
// Hidden helper: Net Income for one standalone fiscal quarter. On Q1–Q3 it is [Net Income]; on the FY 10-K it derives Q4 = FY − Q1 − Q2 − Q3 (BLANK unless all three quarters exist). Used by QoQ and TTM so a quarter is never compared to a full year.

Net Income Standalone Quarter =
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _fp =
    CALCULATE(
        MAX('Income Statement'[fiscal_period]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
VAR _days =
    CALCULATE(
        MAX('Income Statement'[duration_days]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
VAR _annual = _fp = "FY" || _days > 300
VAR _fy_end =
    CALCULATE(
        MAX('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _fy,
        'Date'[is_fiscal_year_end] = TRUE()
    )
VAR _q_ends =
    CALCULATETABLE(
        VALUES('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _fy,
        'Date'[fiscal_quarter] IN { 1, 2, 3 },
        'Date'[is_fiscal_quarter_end] = TRUE()
    )
VAR _q123 =
    ADDCOLUMNS(
        _q_ends,
        "@v",
            VAR _d = 'Date'[date]
            RETURN CALCULATE([Net Income], REMOVEFILTERS('Date'), 'Date'[date] = _d)
    )
VAR _n = COUNTROWS(FILTER(_q123, NOT ISBLANK([@v])))
VAR _annual_value =
    CALCULATE([Net Income], REMOVEFILTERS('Date'), 'Date'[date] = _fy_end)
RETURN
IF(
    _annual,
    IF(_n = 3 && NOT ISBLANK(_annual_value), _annual_value - SUMX(_q123, [@v])),
    [Net Income]
)

// Revenue YoY Change
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: #,##0
// Hidden: false
// Revenue minus the same NVIDIA fiscal quarter in the prior fiscal year (Date[fiscal_year]/[fiscal_quarter] quarter-end). Not SAMEPERIODLASTYEAR. BLANK when the current or prior value is missing.

Revenue YoY Change =
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
VAR _curr = [Revenue]
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _prior_end =
    CALCULATE(
        MAX('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _fy - 1,
        'Date'[fiscal_quarter] = _fq,
        'Date'[is_fiscal_quarter_end] = TRUE()
    )
VAR _prior =
    CALCULATE(
        [Revenue],
        REMOVEFILTERS('Date'),
        'Date'[date] = _prior_end
    )
RETURN
IF(ISBLANK(_curr) || ISBLANK(_prior), BLANK(), _curr - _prior)

// Revenue QoQ Change
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: #,##0
// Hidden: false
// Revenue minus the prior fiscal quarter (Q1 wraps to prior FY Q4, derived as FY − Q1 − Q2 − Q3 via [Revenue Standalone Quarter] so a quarter is never compared to a full year). BLANK when the latest period is the annual 10-K, or when the prior quarter is missing.

Revenue QoQ Change =
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
VAR _curr = [Revenue]
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _fp =
    CALCULATE(
        MAX('Income Statement'[fiscal_period]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
VAR _days =
    CALCULATE(
        MAX('Income Statement'[duration_days]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
VAR _annual = _fp = "FY" || _days > 300
VAR _prior_fy = IF(_fq = 1, _fy - 1, _fy)
VAR _prior_fq = IF(_fq = 1, 4, _fq - 1)
VAR _prior_end =
    CALCULATE(
        MAX('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _prior_fy,
        'Date'[fiscal_quarter] = _prior_fq,
        'Date'[is_fiscal_quarter_end] = TRUE()
    )
VAR _prior =
    CALCULATE(
        [Revenue Standalone Quarter],
        REMOVEFILTERS('Date'),
        'Date'[date] = _prior_end
    )
RETURN
IF(_annual || ISBLANK(_curr) || ISBLANK(_prior), BLANK(), _curr - _prior)

// Revenue QoQ %
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: 0.0%
// Hidden: false
// QoQ change in Revenue as a % of the prior fiscal quarter (Q1 wraps to prior FY Q4, derived as FY − Q1 − Q2 − Q3 via [Revenue Standalone Quarter] so a quarter is never compared to a full year). BLANK when the latest period is the annual 10-K, or when the prior quarter is missing.

Revenue QoQ % =
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
VAR _curr = [Revenue]
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _fp =
    CALCULATE(
        MAX('Income Statement'[fiscal_period]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
VAR _days =
    CALCULATE(
        MAX('Income Statement'[duration_days]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
VAR _annual = _fp = "FY" || _days > 300
VAR _prior_fy = IF(_fq = 1, _fy - 1, _fy)
VAR _prior_fq = IF(_fq = 1, 4, _fq - 1)
VAR _prior_end =
    CALCULATE(
        MAX('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _prior_fy,
        'Date'[fiscal_quarter] = _prior_fq,
        'Date'[is_fiscal_quarter_end] = TRUE()
    )
VAR _prior =
    CALCULATE(
        [Revenue Standalone Quarter],
        REMOVEFILTERS('Date'),
        'Date'[date] = _prior_end
    )
RETURN
IF(_annual || ISBLANK(_curr) || ISBLANK(_prior), BLANK(), DIVIDE(_curr - _prior, _prior))

// Net Income YoY Change
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: #,##0
// Hidden: false
// Net Income minus the same NVIDIA fiscal quarter in the prior fiscal year (Date[fiscal_year]/[fiscal_quarter] quarter-end). Not SAMEPERIODLASTYEAR. BLANK when the current or prior value is missing.

Net Income YoY Change =
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
VAR _curr = [Net Income]
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _prior_end =
    CALCULATE(
        MAX('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _fy - 1,
        'Date'[fiscal_quarter] = _fq,
        'Date'[is_fiscal_quarter_end] = TRUE()
    )
VAR _prior =
    CALCULATE(
        [Net Income],
        REMOVEFILTERS('Date'),
        'Date'[date] = _prior_end
    )
RETURN
IF(ISBLANK(_curr) || ISBLANK(_prior), BLANK(), _curr - _prior)

// Net Income YoY %
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: 0.0%
// Hidden: false
// YoY change in Net Income as a % of the prior fiscal-year same quarter. Uses fiscal calendar, not SAMEPERIODLASTYEAR.

Net Income YoY % =
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
VAR _curr = [Net Income]
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _prior_end =
    CALCULATE(
        MAX('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _fy - 1,
        'Date'[fiscal_quarter] = _fq,
        'Date'[is_fiscal_quarter_end] = TRUE()
    )
VAR _prior =
    CALCULATE(
        [Net Income],
        REMOVEFILTERS('Date'),
        'Date'[date] = _prior_end
    )
RETURN
DIVIDE(_curr - _prior, _prior)

// Net Income QoQ Change
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: #,##0
// Hidden: false
// Net Income minus the prior fiscal quarter (Q1 wraps to prior FY Q4, derived as FY − Q1 − Q2 − Q3 via [Net Income Standalone Quarter] so a quarter is never compared to a full year). BLANK when the latest period is the annual 10-K, or when the prior quarter is missing.

Net Income QoQ Change =
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
VAR _curr = [Net Income]
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _fp =
    CALCULATE(
        MAX('Income Statement'[fiscal_period]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
VAR _days =
    CALCULATE(
        MAX('Income Statement'[duration_days]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
VAR _annual = _fp = "FY" || _days > 300
VAR _prior_fy = IF(_fq = 1, _fy - 1, _fy)
VAR _prior_fq = IF(_fq = 1, 4, _fq - 1)
VAR _prior_end =
    CALCULATE(
        MAX('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _prior_fy,
        'Date'[fiscal_quarter] = _prior_fq,
        'Date'[is_fiscal_quarter_end] = TRUE()
    )
VAR _prior =
    CALCULATE(
        [Net Income Standalone Quarter],
        REMOVEFILTERS('Date'),
        'Date'[date] = _prior_end
    )
RETURN
IF(_annual || ISBLANK(_curr) || ISBLANK(_prior), BLANK(), _curr - _prior)

// Net Income QoQ %
// Table: Balance Sheet
// Display folder: 04-analysis
// Format: 0.0%
// Hidden: false
// QoQ change in Net Income as a % of the prior fiscal quarter (Q1 wraps to prior FY Q4, derived as FY − Q1 − Q2 − Q3 via [Net Income Standalone Quarter] so a quarter is never compared to a full year). BLANK when the latest period is the annual 10-K, or when the prior quarter is missing.

Net Income QoQ % =
VAR _end =
    CALCULATE(
        MAX('Income Statement'[period_end]),
        'Income Statement'[is_latest_filing] = TRUE()
    )
VAR _curr = [Net Income]
VAR _fy =
    CALCULATE(MAX('Date'[fiscal_year]), 'Date'[date] = _end)
VAR _fq =
    CALCULATE(MAX('Date'[fiscal_quarter]), 'Date'[date] = _end)
VAR _fp =
    CALCULATE(
        MAX('Income Statement'[fiscal_period]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
VAR _days =
    CALCULATE(
        MAX('Income Statement'[duration_days]),
        'Income Statement'[is_latest_filing] = TRUE(),
        'Income Statement'[period_end] = _end
    )
VAR _annual = _fp = "FY" || _days > 300
VAR _prior_fy = IF(_fq = 1, _fy - 1, _fy)
VAR _prior_fq = IF(_fq = 1, 4, _fq - 1)
VAR _prior_end =
    CALCULATE(
        MAX('Date'[date]),
        REMOVEFILTERS('Date'),
        'Date'[fiscal_year] = _prior_fy,
        'Date'[fiscal_quarter] = _prior_fq,
        'Date'[is_fiscal_quarter_end] = TRUE()
    )
VAR _prior =
    CALCULATE(
        [Net Income Standalone Quarter],
        REMOVEFILTERS('Date'),
        'Date'[date] = _prior_end
    )
RETURN
IF(_annual || ISBLANK(_curr) || ISBLANK(_prior), BLANK(), DIVIDE(_curr - _prior, _prior))

