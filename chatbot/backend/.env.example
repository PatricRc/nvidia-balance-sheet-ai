# Copy to chatbot/backend/.env for local runs (git-ignored). Placeholders only - never commit real values.

# --- Claude ---------------------------------------------------------------
# Local dev: export ANTHROPIC_API_KEY in your shell (or `ant auth login`).
# Azure: leave it unset; the key is read from Key Vault at startup.
AZURE_KEY_VAULT_NAME=your-key-vault-name
AZURE_KEY_VAULT_SECRET_NAME=anthropic-api-key
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# --- Power BI semantic model (NVIDIA Financials) --------------------------
# live = executeQueries against the model; fixture = offline demo data (no Azure needed)
POWERBI_MODE=fixture
FABRIC_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
POWERBI_DATASET_ID=00000000-0000-0000-0000-000000000000
# Service principal for DefaultAzureCredential (or use a managed identity in Azure and omit these)
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=from-key-vault-or-managed-identity
ALLOW_FREEFORM_DAX=false

# --- Web / abuse controls -------------------------------------------------
# "null" is the origin a Power BI custom visual's sandboxed iframe sends.
ALLOWED_ORIGINS=["http://localhost:8000","null"]
TRUST_PROXY_HEADERS=false
RATE_LIMIT_PER_MINUTE=6
DAILY_REQUEST_BUDGET=500
# CHAT_API_TOKEN=only-for-private-deployments
